# Copy this file to .env and fill in your connection details.

# Local socket connection (default if DSN is not set):
# DSN=dbname=dbname

# Remote / non-default user:
DSN=host=localhost dbname=dbname user=username password=yourpassword

# Auth database (may be on a different host)
AUTH_DSN=host=auth-host dbname=auth_dbname user=username password=yourpassword
